rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-by-default: block all access unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: Verify if user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Verify ID format to prevent injection and malformed keys
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper: Real server-side admin check enforced by verified admin allowlist document in /admins/{uid}
    // Requires non-anonymous authentication, active admin document existence, enabled == true, and role == 'admin'
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: Validate structure of submission created by clients
    function isValidSubmission(data) {
      return data is map &&
        (
          ('questionnaireId' in data && data.questionnaireId is string && data.questionnaireId.size() <= 128) ||
          ('clientCode' in data && data.clientCode is string && data.clientCode.size() <= 128)
        );
    }

    // Helper: Verify if a project exists, is active, and possesses an active matching share token
    function isValidProjectShareToken(projectId, shareToken) {
      return isValidId(projectId) && isValidId(shareToken) &&
        exists(/databases/$(database)/documents/projects/$(projectId)/tokens/$(shareToken)) &&
        get(/databases/$(database)/documents/projects/$(projectId)/tokens/$(shareToken)).data.shareLinkStatus == 'active' &&
        get(/databases/$(database)/documents/projects/$(projectId)/tokens/$(shareToken)).data.status == 'active';
    }

    // Helper: Verify that a client submission matches the project's assigned questionnaire, version, and client
    function isValidProjectSubmission(data) {
      return 'projectId' in data &&
        'shareToken' in data &&
        'questionnaireId' in data &&
        'questionnaireVersion' in data &&
        isValidProjectShareToken(data.projectId, data.shareToken) &&
        data.questionnaireId == get(/databases/$(database)/documents/projects/$(data.projectId)/tokens/$(data.shareToken)).data.questionnaireId &&
        data.questionnaireVersion == get(/databases/$(database)/documents/projects/$(data.projectId)/tokens/$(data.shareToken)).data.questionnaireVersion &&
        (
          !('clientId' in get(/databases/$(database)/documents/projects/$(data.projectId)/tokens/$(data.shareToken)).data) ||
          get(/databases/$(database)/documents/projects/$(data.projectId)/tokens/$(data.shareToken)).data.clientId == null ||
          get(/databases/$(database)/documents/projects/$(data.projectId)/tokens/$(data.shareToken)).data.clientId == '' ||
          ('clientId' in data && data.clientId == get(/databases/$(database)/documents/projects/$(data.projectId)/tokens/$(data.shareToken)).data.clientId)
        );
    }

    // Helper: Verify that a client update to a draft submission preserves strictly immutable fields and valid token
    function isValidClientSubmissionUpdate(currentData, nextData) {
      return currentData.status == 'draft' &&
        (nextData.status == 'draft' || nextData.status == 'submitted') &&
        'projectId' in currentData &&
        'shareToken' in currentData &&
        'questionnaireId' in currentData &&
        'questionnaireVersion' in currentData &&
        'projectId' in nextData &&
        'shareToken' in nextData &&
        'questionnaireId' in nextData &&
        'questionnaireVersion' in nextData &&
        nextData.projectId == currentData.projectId &&
        nextData.shareToken == currentData.shareToken &&
        nextData.questionnaireId == currentData.questionnaireId &&
        nextData.questionnaireVersion == currentData.questionnaireVersion &&
        (
          !('clientId' in currentData) ||
          currentData.clientId == null ||
          currentData.clientId == '' ||
          ('clientId' in nextData && nextData.clientId == currentData.clientId)
        ) &&
        isValidProjectShareToken(currentData.projectId, nextData.shareToken);
    }

    // 0. Workspaces Collection (1 registered user = exactly 1 workspace)
    match /workspaces/{workspaceId} {
      allow get: if isAuthenticated() && (request.auth.uid == workspaceId || isAdmin());
      allow list: if false; // Enumeration protection: users cannot list other workspaces
      allow create: if isAuthenticated() && request.auth.uid == workspaceId &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (request.auth.uid == workspaceId || isAdmin()) &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false; // Workspace deletion disabled
    }

    // User Profiles Collection
    match /users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if false; // Enumeration protection
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Admin Allowlist Collection
    match /admins/{adminId} {
      allow get: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(adminId) && isAdmin();
    }

    // 1. Questionnaires Collection
    match /questionnaires/{questionnaireId} {
      // Unauthenticated clients can fetch definition to render guest forms;
      // Authenticated users are strictly restricted to their own workspace.
      allow get: if isValidId(questionnaireId) &&
        (!isAuthenticated() || !('workspaceId' in resource.data) || resource.data.workspaceId == request.auth.uid || isAdmin());
      // Listing is strictly isolated to the authenticated user's workspace
      allow list: if isAuthenticated() && (resource.data.workspaceId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidId(questionnaireId) &&
        (request.resource.data.workspaceId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && isValidId(questionnaireId) &&
        (resource.data.workspaceId == request.auth.uid || isAdmin()) &&
        (request.resource.data.workspaceId == resource.data.workspaceId || isAdmin());
      allow delete: if isAuthenticated() && isValidId(questionnaireId) &&
        (resource.data.workspaceId == request.auth.uid || isAdmin());

      match /sections/{sectionId} {
        allow get, list: if isValidId(sectionId) &&
          (!isAuthenticated() || !('workspaceId' in get(/databases/$(database)/documents/questionnaires/$(questionnaireId)).data) || get(/databases/$(database)/documents/questionnaires/$(questionnaireId)).data.workspaceId == request.auth.uid || isAdmin());
        allow create, update, delete: if isValidId(sectionId) && isAuthenticated() &&
          (get(/databases/$(database)/documents/questionnaires/$(questionnaireId)).data.workspaceId == request.auth.uid || isAdmin());

        match /questions/{questionId} {
          allow get, list: if isValidId(questionId) &&
            (!isAuthenticated() || !('workspaceId' in get(/databases/$(database)/documents/questionnaires/$(questionnaireId)).data) || get(/databases/$(database)/documents/questionnaires/$(questionnaireId)).data.workspaceId == request.auth.uid || isAdmin());
          allow create, update, delete: if isValidId(questionId) && isAuthenticated() &&
            (get(/databases/$(database)/documents/questionnaires/$(questionnaireId)).data.workspaceId == request.auth.uid || isAdmin());
        }
      }

      match /versions/{versionId} {
        allow get, list: if isValidId(versionId) &&
          (!isAuthenticated() || !('workspaceId' in get(/databases/$(database)/documents/questionnaires/$(questionnaireId)).data) || get(/databases/$(database)/documents/questionnaires/$(questionnaireId)).data.workspaceId == request.auth.uid || isAdmin());
        allow create: if isValidId(versionId) && isAuthenticated() &&
          (get(/databases/$(database)/documents/questionnaires/$(questionnaireId)).data.workspaceId == request.auth.uid || isAdmin());
        allow update, delete: if false; // Immutable historical snapshots
      }

      match /submissions/{submissionId} {
        allow get: if isValidId(submissionId) && isAuthenticated() &&
          (get(/databases/$(database)/documents/questionnaires/$(questionnaireId)).data.workspaceId == request.auth.uid || isAdmin());
        allow list: if isAuthenticated() &&
          (get(/databases/$(database)/documents/questionnaires/$(questionnaireId)).data.workspaceId == request.auth.uid || isAdmin());
        allow create: if isValidId(submissionId) && isValidSubmission(request.resource.data) && (
          (isAuthenticated() && (get(/databases/$(database)/documents/questionnaires/$(questionnaireId)).data.workspaceId == request.auth.uid || isAdmin())) ||
          (
            request.resource.data.status == 'draft' &&
            request.resource.data.questionnaireId == questionnaireId &&
            isValidProjectSubmission(request.resource.data)
          )
        );
        allow update: if isValidId(submissionId) && (
          (isAuthenticated() && (get(/databases/$(database)/documents/questionnaires/$(questionnaireId)).data.workspaceId == request.auth.uid || isAdmin())) ||
          (
            request.resource.data.questionnaireId == questionnaireId &&
            isValidClientSubmissionUpdate(resource.data, request.resource.data) &&
            isValidProjectShareToken(resource.data.projectId, request.resource.data.shareToken)
          )
        );
        allow delete: if false;
      }
    }

    // 2. Global /submissions Collection
    match /submissions/{submissionId} {
      allow get: if isValidId(submissionId) && isAuthenticated() &&
        (resource.data.workspaceId == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.workspaceId == request.auth.uid || isAdmin());
      allow create: if isValidId(submissionId) && isValidSubmission(request.resource.data) && (
        (isAuthenticated() && (request.resource.data.workspaceId == request.auth.uid || isAdmin())) ||
        (
          (request.resource.data.status == 'draft' || request.resource.data.status == 'submitted') &&
          isValidProjectSubmission(request.resource.data)
        )
      );
      allow update: if isValidId(submissionId) && (
        (isAuthenticated() && (resource.data.workspaceId == request.auth.uid || isAdmin())) ||
        (
          isValidClientSubmissionUpdate(resource.data, request.resource.data) &&
          isValidProjectShareToken(resource.data.projectId, request.resource.data.shareToken)
        )
      );
      allow delete: if false; // Permanent deletion strictly prohibited

      match /requirements/{requirementId} {
        allow get, list, create, update, delete: if isAuthenticated() &&
          (get(/databases/$(database)/documents/submissions/$(submissionId)).data.workspaceId == request.auth.uid || isAdmin());
      }

      match /analysis/{analysisId} {
        allow get, list, create, update, delete: if isAuthenticated() &&
          (get(/databases/$(database)/documents/submissions/$(submissionId)).data.workspaceId == request.auth.uid || isAdmin());
      }
    }

    // Cross-project requirements queries (isolated by workspace)
    match /requirements/{requirementId} {
      allow get, list, create, update, delete: if isAuthenticated() &&
        (resource.data.workspaceId == request.auth.uid || isAdmin());
    }

    // 3. Backward-compatible /clientResponses Collection
    match /clientResponses/{responseId} {
      allow get: if isValidId(responseId) && isAuthenticated() &&
        (resource.data.workspaceId == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.workspaceId == request.auth.uid || isAdmin());
      allow create: if isValidId(responseId) && isValidSubmission(request.resource.data) && (
        (isAuthenticated() && (request.resource.data.workspaceId == request.auth.uid || isAdmin())) ||
        (
          (request.resource.data.status == 'draft' || request.resource.data.status == 'submitted') &&
          isValidProjectSubmission(request.resource.data)
        )
      );
      allow update: if isValidId(responseId) && (
        (isAuthenticated() && (resource.data.workspaceId == request.auth.uid || isAdmin())) ||
        (
          isValidClientSubmissionUpdate(resource.data, request.resource.data) &&
          isValidProjectShareToken(resource.data.projectId, request.resource.data.shareToken)
        )
      );
      allow delete: if false;
    }

    // 4. Clients Management Collection
    match /clients/{clientId} {
      allow get: if isValidId(clientId) && isAuthenticated() &&
        (resource.data.workspaceId == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.workspaceId == request.auth.uid || isAdmin());
      allow create: if isValidId(clientId) && isAuthenticated() &&
        (request.resource.data.workspaceId == request.auth.uid || isAdmin());
      allow update: if isValidId(clientId) && isAuthenticated() &&
        (resource.data.workspaceId == request.auth.uid || isAdmin()) &&
        (request.resource.data.workspaceId == resource.data.workspaceId || isAdmin());
      allow delete: if isValidId(clientId) && isAuthenticated() &&
        (resource.data.workspaceId == request.auth.uid || isAdmin());
    }

    // 5. Projects Management Collection
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && isAuthenticated() &&
        (resource.data.workspaceId == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.workspaceId == request.auth.uid || isAdmin());
      allow create: if isValidId(projectId) && isAuthenticated() &&
        (request.resource.data.workspaceId == request.auth.uid || isAdmin());
      allow update: if isValidId(projectId) && isAuthenticated() &&
        (resource.data.workspaceId == request.auth.uid || isAdmin()) &&
        (request.resource.data.workspaceId == resource.data.workspaceId || isAdmin());
      allow delete: if isValidId(projectId) && isAuthenticated() &&
        (resource.data.workspaceId == request.auth.uid || isAdmin());

      // Scoped Project Share-Token access
      match /tokens/{shareToken} {
        allow get: if isValidId(projectId) && isValidId(shareToken) &&
          resource.data.status == 'active' &&
          resource.data.shareLinkStatus == 'active' &&
          resource.data.projectId == projectId;
        allow list: if isAuthenticated() &&
          (get(/databases/$(database)/documents/projects/$(projectId)).data.workspaceId == request.auth.uid || isAdmin());
        allow create, update, delete: if isValidId(shareToken) && isAuthenticated() &&
          (get(/databases/$(database)/documents/projects/$(projectId)).data.workspaceId == request.auth.uid || isAdmin());

        // Isolated Client Drafts subcollection
        match /drafts/{draftId} {
          allow get: if isValidId(draftId) && isValidProjectShareToken(projectId, shareToken);
          allow list: if isAuthenticated() &&
            (get(/databases/$(database)/documents/projects/$(projectId)).data.workspaceId == request.auth.uid || isAdmin());
          allow create: if isValidId(draftId) &&
            isValidProjectShareToken(projectId, shareToken) &&
            request.resource.data.projectId == projectId &&
            request.resource.data.shareToken == shareToken &&
            request.resource.data.status == 'draft' &&
            isValidProjectSubmission(request.resource.data);
          allow update: if isValidId(draftId) &&
            isValidProjectShareToken(projectId, shareToken) &&
            request.resource.data.projectId == projectId &&
            request.resource.data.shareToken == shareToken &&
            isValidClientSubmissionUpdate(resource.data, request.resource.data);
          allow delete: if false;
        }
      }
    }

    // 6. Public Forms Collection (Safe presentation metadata only)
    match /publicForms/{publicFormId} {
      // Unauthenticated public clients can get public form info
      allow get: if isValidId(publicFormId);
      // Listing public forms is strictly restricted to the workspace owner or admin
      allow list: if isAuthenticated() && (resource.data.workspaceId == request.auth.uid || isAdmin());
      allow create: if isValidId(publicFormId) && isAuthenticated() &&
        (request.resource.data.workspaceId == request.auth.uid || isAdmin());
      allow update: if isValidId(publicFormId) && isAuthenticated() &&
        (resource.data.workspaceId == request.auth.uid || isAdmin()) &&
        (request.resource.data.workspaceId == resource.data.workspaceId || isAdmin());
      allow delete: if isValidId(publicFormId) && isAuthenticated() &&
        (resource.data.workspaceId == request.auth.uid || isAdmin());
    }

    // 7. Public Forms Isolated Security Records (PIN hashes, salts, encrypted capability tokens)
    match /publicFormsSecurity/{publicFormId} {
      // Unauthenticated public clients are STRICTLY PROHIBITED from reading security records
      allow get, list: if isAuthenticated() && (resource.data.workspaceId == request.auth.uid || isAdmin());
      allow create: if isValidId(publicFormId) && isAuthenticated() &&
        (request.resource.data.workspaceId == request.auth.uid || isAdmin());
      allow update: if isValidId(publicFormId) && isAuthenticated() &&
        (resource.data.workspaceId == request.auth.uid || isAdmin()) &&
        (request.resource.data.workspaceId == resource.data.workspaceId || isAdmin());
      allow delete: if isValidId(publicFormId) && isAuthenticated() &&
        (resource.data.workspaceId == request.auth.uid || isAdmin());
    }
  }
}


